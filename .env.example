# Copie para .env.local e preencha. NUNCA comite o arquivo real.

# Senha do painel /admin (somente servidor; use uma senha longa e forte)
ADMIN_PASSWORD=

# Segredo para assinar a sessão do admin (mín. 32 caracteres, diferente da senha).
# Gere com: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Supabase (banco + storage). Sem estas variáveis, o app usa products.json local (só desenvolvimento)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
