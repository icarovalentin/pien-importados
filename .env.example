# Copie este arquivo para .env.local e preencha os valores.
# Os valores reais de producao ficam na Vercel (Settings > Environment Variables).
# NUNCA comite o .env.local: ele esta no .gitignore.

# URL do projeto Supabase (Project Settings > API). E publica, aparece no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role do Supabase. E SECRETA: da acesso total ao banco.
# So existe no servidor (rotas da API e scripts locais). Nunca vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Senha do painel /admin.
ADMIN_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Chave que assina o cookie de sessao do painel.
ADMIN_SESSION_SECRET=troque-por-uma-chave-aleatoria-longa
