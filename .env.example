# Copie para .env.local e preencha. NUNCA comite o arquivo real.

# Senha do painel /admin (somente servidor; use uma senha longa e forte)
ADMIN_PASSWORD=

# Segredo para assinar a sessão do admin (mín. 32 caracteres, diferente da senha).
# Gere com: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Supabase (banco + storage). Sem estas variáveis, o app usa products.json local (só desenvolvimento)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (anon/publishable) usada apenas na leitura pública do catálogo respeitando RLS (recomendada)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave administrativa usada exclusivamente no servidor (escrita no /admin, upload e segurança)
SUPABASE_SERVICE_ROLE_KEY=

# URL canônica do site (usada em OpenGraph/SEO; opcional na Vercel)
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (opcional): se ausente, usa a tabela admin_login_attempts do Supabase (ou memória local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
